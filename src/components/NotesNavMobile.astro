---
import NotesTree from '@/components/NotesTree.astro';
import type { NotesTopic } from '@/utils/notes';
import { parseNotesPath } from '@/utils/notes';

interface Props {
	topics: NotesTopic[];
}
const { topics } = Astro.props;
const { activeTopicSlug, activeArticleSlug } = parseNotesPath(
	Astro.url.pathname,
);
---

<div class="float-btn float-btn-left fixed left-16 top-20 z-20 lg:hidden">
	<button
		type="button"
		id="notes-nav-toggle"
		aria-label="打开笔记目录"
		aria-expanded="false"
		aria-controls="notes-nav-panel"
		class="content-bg rounded-full flex h-10 w-10 items-center justify-center text-white/80 shadow-lg shadow-black/30 backdrop-blur-md transition-all duration-200 hover:scale-105 hover:border-gray/70 hover:bg-white/10 hover:text-white active:scale-95"
	>
		<svg
			aria-hidden="true"
			width="18"
			height="18"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<line x1="3" y1="6" x2="21" y2="6"></line>
			<line x1="6" y1="12" x2="21" y2="12"></line>
			<line x1="9" y1="18" x2="21" y2="18"></line>
		</svg>
	</button>
</div>
<div
	id="notes-nav-panel"
	class="pop-panel popup-bg no-scrollbar fixed left-16 top-32 z-20 w-72 max-h-[70vh] overflow-y-auto p-3 lg:hidden"
	aria-hidden="true"
	inert
>
	<NotesTree
		topics={topics}
		activeTopicSlug={activeTopicSlug}
		activeArticleSlug={activeArticleSlug}
	/>
</div>
