---
import Layout from '../layouts/Layout.astro';
import FormattedDate from './FormattedDate.astro';
import Toc from './Toc.astro';
import BackButton from './BackButton.astro';
import MobileToc from './MobileToc.astro';

export interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	h1Title: string;
	description?: string;
	image?: string;
	headings: Heading[];
	pubDate: Date;
	updatedDate?: Date;
	tags: string[];
	tagBasePath: string;
	backFallback: string;
	section: string;
	pagefindMeta?: string;
	extraArticleAttrs?: Record<string, string>;
}

const {
	title,
	h1Title,
	description,
	image,
	headings,
	pubDate,
	updatedDate,
	tags,
	tagBasePath,
	backFallback,
	section,
	pagefindMeta,
	extraArticleAttrs = {},
} = Astro.props;

const toc = headings.filter((h) => h.depth > 1 && h.depth < 4);
const pfMeta = pagefindMeta ?? 'section[data-pf-section]';

const articleAttrs: Record<string, string> = {
	'data-pf-section': section,
	'data-pagefind-meta': pfMeta,
	'data-pagefind-filter': `section:${section}`,
	...extraArticleAttrs,
};
---

<Layout title={title} description={description} image={image}>
	<BackButton fallbackHref={backFallback} slot="floating" />
	<MobileToc headings={headings} slot="floating" />
	<slot name="floating-extras" slot="floating" />
	<article
		class="prose prose-invert max-w-none prose-headings:scroll-mt-32 prose-pre:bg-transparent prose-pre:p-0"
		{...articleAttrs}
	>
		<div
			class="mx-auto max-w-3xl xl:max-w-none xl:grid xl:grid-cols-[1fr_minmax(0,48rem)_1fr] xl:gap-6"
		>
			<slot name="left-sidebar" />
			<div class="content-bg min-w-0 p-6 sm:p-7 xl:col-start-2">
				<header class="not-prose mb-8">
					<h1 class="text-3xl font-bold text-white sm:text-4xl">
						{h1Title}
					</h1>
					<div
						class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray"
					>
						<span>发布于 <FormattedDate date={pubDate} /></span>
						{
							updatedDate && (
								<span>
									· 更新于 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					{
						tags.length > 0 && (
							<div class="mt-3 flex flex-wrap gap-2 text-xs">
								{tags.map((t) => (
									<a
										href={`${tagBasePath}${t}/`}
										class="content-bg rounded-full px-2.5 py-0.5 text-white/70 transition-all duration-200 hover:scale-105 hover:border-gray hover:text-white active:scale-95"
									>
										#{t}
									</a>
								))}
							</div>
						)
					}
				</header>
				<div data-pagefind-body>
					<slot />
				</div>
			</div>
			{
				toc.length > 0 && (
					<aside class="hidden xl:block xl:col-start-3 justify-self-start">
						<div class="content-bg sticky top-20 w-48 p-3">
							<Toc headings={headings} />
						</div>
					</aside>
				)
			}
		</div>
	</article>
</Layout>
