---
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/'
		? path === '/'
		: path === href || path.startsWith(href + '/') || path.startsWith(href);

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/articles', label: 'Articles' },
	{ href: '/notes', label: 'Notes' },
];
---

<header
	class="sticky top-0 z-30 border-b border-white/5 bg-black/20 backdrop-blur-md"
>
	<nav
		class="relative mx-auto flex h-15 items-center justify-between pl-6 pr-3"
	>
		<a
			href="/"
			class="text-xl font-bold text-white transition-colors hover:text-accent"
			>{SITE_TITLE}</a
		>

		<div
			class="absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 items-center gap-1 text-xl text-white/70 md:flex"
		>
			{
				links.map((l) => (
					<a
						href={l.href}
						class:list={[
							'-mb-px border-b-4 px-2 py-2 transition-colors hover:text-white',
							isActive(l.href)
								? 'font-bold text-white border-accent/50'
								: 'font-normal border-transparent',
						]}
					>
						{l.label}
					</a>
				))
			}
		</div>

		<div class="flex items-center gap-2 text-white/70">
			<button
				type="button"
				id="menu-toggle"
				aria-label="菜单"
				aria-expanded="false"
				aria-controls="mobile-menu"
				class="flex items-center justify-center rounded-lg border border-white/10 bg-white/5 px-2.5 py-1.5 text-sm backdrop-blur-md transition-all duration-200 hover:scale-105 hover:bg-white/10 hover:text-white active:scale-95 md:hidden"
			>
				<svg
					aria-hidden="true"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
			</button>
			<button
				type="button"
				id="search-trigger"
				aria-label="搜索"
				class="flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-2.5 py-1.5 text-sm backdrop-blur-md transition-all duration-200 hover:scale-105 hover:bg-white/10 hover:text-white active:scale-95"
			>
				<svg
					aria-hidden="true"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.3-4.3"></path>
				</svg>
				<span class="hidden sm:inline">Search</span>
				<kbd
					class="hidden sm:inline-flex items-center gap-0.5 rounded border border-white/15 px-1.5 py-0.5 text-[10px] font-sans leading-none text-white/60"
					><kbd>⌘</kbd><kbd>K</kbd></kbd
				>
			</button>
			<a
				href="/rss.xml"
				class="hidden rounded px-2.5 py-1.5 transition-all duration-200 hover:scale-105 hover:bg-white/10 hover:text-white active:scale-95 sm:inline-flex"
				aria-label="RSS 订阅"
			>
				<svg
					aria-hidden="true"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="currentColor"
				>
					<path
						d="M2.88 16.88a3 3 0 0 0 0 4.24 3 3 0 0 0 4.24 0 3 3 0 0 0-4.24-4.24Zm2.83 2.83a1 1 0 0 1-1.42-1.42 1 1 0 0 1 1.42 0 1 1 0 0 1 0 1.42ZM5 12a1 1 0 0 0 0 2 5 5 0 0 1 5 5 1 1 0 0 0 2 0 7 7 0 0 0-7-7Zm0-4a1 1 0 0 0 0 2 9 9 0 0 1 9 9 1 1 0 0 0 2 0 11.08 11.08 0 0 0-3.22-7.78A11.08 11.08 0 0 0 5 8Zm10.61.39A15.11 15.11 0 0 0 5 4a1 1 0 0 0 0 2 13 13 0 0 1 13 13 1 1 0 0 0 2 0 15.11 15.11 0 0 0-4.39-10.61Z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<div
	id="mobile-menu"
	class="popup-bg p-2 fixed top-15 z-30 hidden w-36 md:hidden"
	aria-hidden="true"
>
	<nav class="flex flex-col gap-0.5 text-white/80">
		{
			links.map((l) => (
				<a
					href={l.href}
					class:list={[
						'flex items-center gap-2.5 rounded-lg px-3 py-2 text-base font-medium transition-colors hover:bg-white/10 hover:text-white',
						isActive(l.href) ? 'text-white' : 'text-white/70',
					]}
				>
					<span
						class:list={[
							'h-1.5 w-1.5 rounded-full bg-accent',
							isActive(l.href) ? 'opacity-100' : 'opacity-40',
						]}
					/>
					{l.label}
				</a>
			))
		}
	</nav>
</div>

<dialog
	id="search-dialog"
	class="popup-bg p-0 mx-auto my-0 w-full max-w-2xl text-white backdrop:backdrop-blur-sm"
>
	<div class="flex flex-col">
		<div
			class="flex items-center justify-between border-b border-white/10 px-4 py-3"
		>
			<span class="text-sm font-semibold text-white/80">搜索</span>
			<button
				type="button"
				id="search-close"
				class="rounded px-2 py-1 text-sm text-white/50 transition-all duration-200 hover:bg-white/10 hover:text-white active:scale-95"
				>关闭 <kbd class="ml-1 text-xs">Esc</kbd></button
			>
		</div>
		<div class="max-h-[70vh] overflow-y-auto p-4" data-pagefind-ignore>
			<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
			<script is:inline type="module">
				const esc = (s) =>
					String(s ?? '').replace(
						/[&<>"']/g,
						(c) =>
							({
								'&': '&amp;',
								'<': '&lt;',
								'>': '&gt;',
								'"': '&quot;',
								"'": '&#39;',
							})[c],
					);

				const getResultTemplate = () => (result) => {
					const m = result?.meta ?? {};
					const section = esc(m.section);
					const topic = esc(m.topic);
					const kind = esc(m.kind);
					const title = esc(m.title || 'Untitled');
					const url = esc(m.url || result?.url || '');
					const excerpt = result?.excerpt || '';

					let crumbs = '';
					if (section === 'notes') {
						crumbs =
							'<p class="search-result-crumbs"><span class="search-crumb">Notes</span>';
						if (topic)
							crumbs += `<span class="search-crumb-sep">›</span><span class="search-crumb">${topic}</span>`;
						if (kind === 'intro')
							crumbs += '<span class="search-crumb-tag">主题首页</span>';
						crumbs += '</p>';
					} else if (section === 'articles') {
						crumbs =
							'<p class="search-result-crumbs"><span class="search-crumb">Articles</span></p>';
					}

					return `<li class="search-result">
						<div class="search-result-card">
							<div class="search-result-content">
								${crumbs}
								<p class="search-result-title"><a class="search-result-link" href="${url}">${title}</a></p>
								${excerpt ? `<p class="search-result-excerpt">${excerpt}</p>` : ''}
							</div>
						</div>
					</li>`;
				};

				const applyResultTemplate = (doc) => {
					const pfResults = doc.querySelector(
						'pagefind-results[instance="site-search"]',
					);
					if (!pfResults || pfResults.dataset.tplBound) return;
					pfResults.dataset.tplBound = '1';
					pfResults.resultTemplate = getResultTemplate();
				};

				const bindSectionPills = () => {
					const wrap = document.getElementById('section-filter');
					if (!wrap || wrap.dataset.bound) return;
					wrap.dataset.bound = '1';
					const pills = wrap.querySelectorAll('button[data-section]');
					if (!pills.length) return;
					const activeSections = () =>
						Array.from(pills)
							.filter((b) => b.getAttribute('aria-pressed') === 'true')
							.map((b) => b.dataset.section);
					const apply = () => {
						const input = document.querySelector(
							'pagefind-input[instance="site-search"]',
						);
						const inst = input?.instance;
						if (!inst || typeof inst.triggerFilters !== 'function') return;
						const a = activeSections();
						if (a.length === 0 || a.length === pills.length) {
							inst.triggerFilters({});
						} else {
							inst.triggerFilters({ section: a });
						}
					};
					pills.forEach((btn) =>
						btn.addEventListener('click', () => {
							btn.setAttribute(
								'aria-pressed',
								String(btn.getAttribute('aria-pressed') !== 'true'),
							);
							apply();
						}),
					);
				};

				applyResultTemplate(document);
				bindSectionPills();

				document.addEventListener('astro:page-load', () => {
					applyResultTemplate(document);
					bindSectionPills();
				});

				document.addEventListener('astro:before-swap', (e) => {
					applyResultTemplate(e.newDocument);

					const d = document.getElementById('search-dialog');
					if (d?.open) {
						if (typeof d.close === 'function') d.close();
						else d.removeAttribute('open');
					}
				});

				try {
					await import('/pagefind/pagefind-component-ui.js');
				} catch (e) {
					const el = document.getElementById('search-fallback');
					if (el)
						el.textContent =
							'搜索索引在开发模式下尚未生成。请运行 pnpm build && pnpm preview 后使用。';
				}
			</script>
			<p id="search-fallback" class="text-sm text-white/40"></p>
			<pagefind-input instance="site-search" class="block"></pagefind-input>
			<div class="mt-3 flex items-center gap-2">
				<pagefind-summary instance="site-search" class="block"
				></pagefind-summary>
				<div
					id="section-filter"
					class="ml-auto flex items-center gap-1.5"
					role="group"
					aria-label="版块筛选"
				>
					<button
						type="button"
						class="search-section-pill"
						data-section="articles"
						aria-pressed="true">Articles</button
					>
					<button
						type="button"
						class="search-section-pill"
						data-section="notes"
						aria-pressed="true">Notes</button
					>
				</div>
			</div>
			<pagefind-results instance="site-search" class="block">
			</pagefind-results>
		</div>
	</div>
</dialog>

<script is:inline>
	(() => {
		const getDialog = () => document.getElementById('search-dialog');

		const openDialog = () => {
			const d = getDialog();
			if (!d) return;
			if (typeof d.showModal === 'function') d.showModal();
			else d.setAttribute('open', '');
		};
		const closeDialog = () => {
			const d = getDialog();
			if (!d) return;
			if (typeof d.close === 'function') d.close();
			else d.removeAttribute('open');
		};

		const bindSearchUI = () => {
			const d = getDialog();
			const t = document.getElementById('search-trigger');
			const c = document.getElementById('search-close');
			if (!d || !t) return;

			t.addEventListener('click', openDialog);
			c?.addEventListener('click', closeDialog);
			d.addEventListener('click', (ev) => {
				if (ev.target === d) closeDialog();
			});
		};

		const bindMobileMenu = () => {
			const menuToggle = document.getElementById('menu-toggle');
			const mobileMenu = document.getElementById('mobile-menu');
			if (!menuToggle || !mobileMenu) return;

			const toggleMenu = (force) => {
				const willOpen =
					force === undefined ? mobileMenu.classList.contains('hidden') : force;
				if (willOpen) {
					const r = menuToggle.getBoundingClientRect();
					if (r.left + 144 <= window.innerWidth - 8) {
						mobileMenu.style.left = r.left + 'px';
						mobileMenu.style.right = 'auto';
					} else {
						mobileMenu.style.right = '8px';
						mobileMenu.style.left = 'auto';
					}
				}
				mobileMenu.classList.toggle('hidden', !willOpen);
				menuToggle.setAttribute('aria-expanded', String(willOpen));
			};
			menuToggle.addEventListener('click', (e) => {
				e.stopPropagation();
				toggleMenu();
			});
			mobileMenu
				.querySelectorAll('a')
				.forEach((a) => a.addEventListener('click', () => toggleMenu(false)));
			document.addEventListener('click', (e) => {
				if (mobileMenu.classList.contains('hidden')) return;
				if (!menuToggle.contains(e.target) && !mobileMenu.contains(e.target))
					toggleMenu(false);
			});
		};

		bindSearchUI();
		bindMobileMenu();
		document.addEventListener('astro:after-swap', () => {
			bindSearchUI();
			bindMobileMenu();
		});

		if (!window.__searchKeydownBound) {
			window.__searchKeydownBound = true;
			const isMac = /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform);
			document.addEventListener('keydown', (e) => {
				if ((isMac ? e.metaKey : e.ctrlKey) && e.key.toLowerCase() === 'k') {
					e.preventDefault();
					openDialog();
				}
			});
		}
	})();
</script>
