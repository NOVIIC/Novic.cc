---
import NotesTree from '@/components/NotesTree.astro';
import type { NotesTopic } from '@/utils/notes';
import { parseNotesPath } from '@/utils/notes';

interface Props {
	topics: NotesTopic[];
	class?: string;
}
const { topics, class: className = '' } = Astro.props;
const { activeTopicSlug, activeArticleSlug } = parseNotesPath(
	Astro.url.pathname,
);
---

<aside
	class={`notes-nav-aside not-prose hidden lg:col-start-1 lg:block xl:justify-self-end xl:w-54 ${className}`}
	transition:name="notes-nav-desktop"
	transition:persist="notes-nav-desktop"
	transition:animate="none"
>
	<div
		class="content-bg no-scrollbar sticky top-20 max-h-[calc(100dvh-6rem)] w-full overflow-y-auto p-3"
	>
		<NotesTree
			topics={topics}
			activeTopicSlug={activeTopicSlug}
			activeArticleSlug={activeArticleSlug}
		/>
	</div>
</aside>
