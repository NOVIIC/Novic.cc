---
import NotesTree from './NotesTree.astro';
import { getNotesTree, parseNotesPath } from '../utils/notes';

interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;

const topics = await getNotesTree();
const { activeTopicSlug, activeArticleSlug } = parseNotesPath(
	Astro.url.pathname,
);
---

<aside
	class={`notes-nav-aside not-prose hidden xl:block ${className}`}
	transition:name="notes-nav"
>
	<div
		class="content-bg no-scrollbar sticky top-20 max-h-[calc(100dvh-6rem)] w-full overflow-y-auto p-3"
	>
		<NotesTree
			topics={topics}
			activeTopicSlug={activeTopicSlug}
			activeArticleSlug={activeArticleSlug}
		/>
	</div>
</aside>
