---
interface Props {
	tags: { tag: string; count: number; href: string }[];
}
const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<section class="not-prose mb-10">
			<h2 class="mb-3 text-sm font-semibold text-white/50 px-3 sm:px-0">
				标签
			</h2>
			<div class="flex flex-wrap gap-2 text-sm">
				{tags.map(({ tag, count, href }) => (
					<a
						href={href}
						class="content-bg rounded-full px-3 py-1 text-white/75 transition-all duration-200 hover:scale-105 hover:border-gray hover:text-white active:scale-95"
					>
						#{tag} <span class="text-white/40">{count}</span>
					</a>
				))}
			</div>
		</section>
	)
}
