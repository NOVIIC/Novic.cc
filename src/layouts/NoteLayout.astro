---
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Toc from '../components/Toc.astro';
import BackButton from '../components/BackButton.astro';
import MobileToc from '../components/MobileToc.astro';
import NotesNav from '../components/NotesNav.astro';
import NotesNavMobile from '../components/NotesNavMobile.astro';
import { SITE_TITLE } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}
interface Props {
	note: CollectionEntry<'notes'>;
	headings: Heading[];
	topic: string;
	topicTitle: string;
	isIntro?: boolean;
}
const { note, headings, topic, topicTitle, isIntro = false } = Astro.props;
const { description, pubDate, updatedDate, tags } = note.data;
const displayTitle = isIntro ? '前言' : note.data.title;
const pageTitle = isIntro ? `${topicTitle} · ${SITE_TITLE}` : note.data.title;
const fallbackHref = isIntro ? '/notes/' : `/notes/${topic}/intro/`;
---

<Layout title={pageTitle} description={description} wide>
	<BackButton fallbackHref={fallbackHref} slot="floating" />
	<MobileToc headings={headings} slot="floating" />
	<NotesNavMobile slot="floating" />
	<article
		class="prose prose-invert max-w-none prose-headings:scroll-mt-32 prose-pre:bg-transparent prose-pre:p-0"
	>
		<div class="xl:grid xl:grid-cols-[15rem_1fr_9rem] xl:gap-6">
			<NotesNav />
			<div class="content-bg min-w-0 p-6 sm:p-7">
				<header class="not-prose mb-8">
					<h1 class="text-3xl font-bold text-white sm:text-4xl">
						{displayTitle}
					</h1>
					<div
						class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray"
					>
						<span>发布于 <FormattedDate date={pubDate} /></span>
						{
							updatedDate && (
								<span>
									· 更新于 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					{
						tags.length > 0 && (
							<div class="mt-3 flex flex-wrap gap-2 text-xs">
								{tags.map((t) => (
									<a
										href={`/notes/tags/${t}/`}
										class="content-bg rounded-full px-2.5 py-0.5 text-white/70 transition-all duration-200 hover:scale-105 hover:border-gray hover:text-white active:scale-95"
									>
										#{t}
									</a>
								))}
							</div>
						)
					}
				</header>
				<div data-pagefind-body>
					<slot />
				</div>
			</div>
			<aside class="hidden lg:block">
				<div class="content-bg sticky top-20 p-3">
					<Toc headings={headings} />
				</div>
			</aside>
		</div>
	</article>
</Layout>
