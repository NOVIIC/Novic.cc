---
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Toc from '../components/Toc.astro';
import { NOTES_TOPIC_MAP } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}
interface Props {
	note: CollectionEntry<'notes'>;
	headings: Heading[];
	topic: string;
}
const { note, headings, topic } = Astro.props;
const { title, description, pubDate, updatedDate } = note.data;
const topicMeta = NOTES_TOPIC_MAP[topic];
---

<Layout title={title} description={description}>
	<article class="prose prose-invert max-w-none prose-headings:scroll-mt-20 prose-pre:bg-transparent prose-pre:p-0">
		<header class="not-prose mb-8">
			{
				topicMeta && (
					<a
						href={`/notes/${topic}/`}
						class="text-sm text-white/60 transition-colors hover:text-[var(--accent)]"
					>
						← {topicMeta.title}
					</a>
				)
			}
			<h1 class="mt-2 text-4xl font-bold text-white">{title}</h1>
			<div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm" style="color: rgb(var(--gray));">
				<span>发布于 <FormattedDate date={pubDate} /></span>
				{
					updatedDate && (
						<span>· 更新于 <FormattedDate date={updatedDate} /></span>
					)
				}
			</div>
		</header>

		<div class="lg:grid lg:grid-cols-[1fr_9rem] lg:gap-6">
			<div class="min-w-0" data-pagefind-body>
				<slot />
			</div>
			<aside class="hidden lg:block">
				<div class="sticky top-20">
					<Toc headings={headings} />
				</div>
			</aside>
		</div>
	</article>
</Layout>
