---
import ContentLayout, { type Heading } from '@/components/ContentLayout.astro';
import NotesNav from '@/components/NotesNav.astro';
import NotesNavMobile from '@/components/NotesNavMobile.astro';
import { SITE_TITLE } from '@/consts';
import { getNotesTree } from '@/utils/notes';
import type { CollectionEntry } from 'astro:content';

interface Props {
	note: CollectionEntry<'notes'>;
	headings: Heading[];
	topic: string;
	topicTitle: string;
	isIntro?: boolean;
}
const { note, headings, topic, topicTitle, isIntro = false } = Astro.props;
const { description, pubDate, updatedDate, tags } = note.data;
const displayTitle = isIntro ? '前言' : note.data.title;
const pageTitle = isIntro ? `${topicTitle} · ${SITE_TITLE}` : note.data.title;
const fallbackHref = isIntro ? '/notes/' : `/notes/${topic}/intro/`;

const navTopics = await getNotesTree();

const pagefindMeta = isIntro
	? 'section[data-pf-section], topic[data-pf-topic], kind[data-pf-kind], title[data-pf-topic]'
	: 'section[data-pf-section], topic[data-pf-topic], kind[data-pf-kind]';

const extraArticleAttrs = {
	'data-pf-topic': topicTitle,
	'data-pf-kind': isIntro ? 'intro' : 'article',
};
---

<ContentLayout
	title={pageTitle}
	h1Title={displayTitle}
	description={description}
	headings={headings}
	pubDate={pubDate}
	updatedDate={updatedDate}
	tags={tags}
	tagBasePath="/notes/tags/"
	backFallback={fallbackHref}
	section="notes"
	pagefindMeta={pagefindMeta}
	extraArticleAttrs={extraArticleAttrs}
>
	<NotesNav topics={navTopics} slot="left-sidebar" />
	<NotesNavMobile topics={navTopics} slot="floating-extras" />
	<slot />
</ContentLayout>
