---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description?: string;
	image?: string;
	wide?: boolean;
}
const { title, description, image, wide = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={image} />
		<Font cssVariable="--font-atkinson" preload />
		<ClientRouter />
		<noscript>
			<style>
				.float-btn {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>
	</head>
	<body
		data-pf-theme="dark"
		class="relative flex min-h-[calc(100dvh+5.5rem)] flex-col font-sans antialiased"
	>
		<Header />
		<main
			transition:name="main"
			class:list={[
				'relative z-10 mx-auto w-full flex-1 px-4 py-10',
				wide ? 'max-w-3xl xl:max-w-5xl' : 'max-w-3xl',
			]}
		>
			<slot />
		</main>
		<Footer />
		<slot name="floating" />
		<script>
			// 页面切换：跨版块（Home ↔ Articles ↔ Notes）横向滑动，
			// 同版块内切换淡入上浮。
			// 版块在导航栏中的顺序：Home=0, Articles=1, Notes=2
			const sectionIndex = (pathname: string): number => {
				if (pathname === '/') return 0;
				if (pathname.startsWith('/articles')) return 1;
				if (pathname.startsWith('/notes')) return 2;
				return 0;
			};
			document.addEventListener('astro:before-swap', (e) => {
				const ev = e as unknown as {
					from: URL;
					to: URL;
					newDocument: Document;
				};
				let vt = 'fade';
				let dir = 'forward';
				const oi = sectionIndex(ev.from.pathname);
				const ni = sectionIndex(ev.to.pathname);
				if (oi !== ni) {
					vt = 'slide';
					dir = ni > oi ? 'forward' : 'back';
				}
				const root = ev.newDocument.documentElement;
				root.dataset.vt = vt;
				root.dataset.vtDir = dir;
			});

			const enterFloatBtns = () => {
				requestAnimationFrame(() => {
					document
						.querySelectorAll('.float-btn:not(.is-entered)')
						.forEach((b) => b.classList.add('is-entered'));
				});
			};
			enterFloatBtns();
			document.addEventListener('astro:page-load', enterFloatBtns);

			// 返回按钮 + 目录开关逻辑（每次导航后重新绑定当前 DOM）
			const setupFloatingUI = () => {
				const backBtn =
					document.querySelector<HTMLElement>('[data-back-button]');
				if (backBtn && !backBtn.dataset.bound) {
					backBtn.dataset.bound = '1';
					backBtn.addEventListener('click', () => {
						if (history.length > 1) history.back();
						else location.href = backBtn.getAttribute('data-fallback') || '/';
					});
				}

				const tocToggle = document.getElementById('toc-toggle');
				const tocPanel = document.getElementById('mobile-toc');
				if (tocToggle && tocPanel && !tocToggle.dataset.bound) {
					tocToggle.dataset.bound = '1';
					const close = () => {
						tocPanel.classList.remove('is-open');
						tocPanel.setAttribute('aria-hidden', 'true');
						tocPanel.inert = true;
						tocToggle.setAttribute('aria-expanded', 'false');
					};
					const open = () => {
						tocPanel.classList.add('is-open');
						tocPanel.setAttribute('aria-hidden', 'false');
						tocPanel.inert = false;
						tocToggle.setAttribute('aria-expanded', 'true');
					};
					tocToggle.addEventListener('click', (e) => {
						e.stopPropagation();
						tocPanel.classList.contains('is-open') ? close() : open();
					});
					tocPanel
						.querySelectorAll('a')
						.forEach((a) => a.addEventListener('click', close));
				}

				// Notes 左侧目录树：窄屏面板开关
				const navToggle = document.getElementById('notes-nav-toggle');
				const navPanel = document.getElementById('notes-nav-panel');
				if (navToggle && navPanel && !navToggle.dataset.bound) {
					navToggle.dataset.bound = '1';
					const closeNav = () => {
						navPanel.classList.remove('is-open');
						navPanel.setAttribute('aria-hidden', 'true');
						navPanel.inert = true;
						navToggle.setAttribute('aria-expanded', 'false');
					};
					const openNav = () => {
						navPanel.classList.add('is-open');
						navPanel.setAttribute('aria-hidden', 'false');
						navPanel.inert = false;
						navToggle.setAttribute('aria-expanded', 'true');
					};
					navToggle.addEventListener('click', (e) => {
						e.stopPropagation();
						navPanel.classList.contains('is-open') ? closeNav() : openNav();
					});
					navPanel
						.querySelectorAll('a')
						.forEach((a) => a.addEventListener('click', closeNav));
				}

				// Notes 目录树展开/收起 + 跨页面状态持久化（localStorage）
				const notesTopics =
					document.querySelectorAll<HTMLElement>('.notes-topic');
				if (notesTopics.length > 0) {
					let stored: string[] = [];
					try {
						stored = JSON.parse(
							localStorage.getItem('notes-nav-expanded') || '[]',
						);
					} catch {
						stored = [];
					}
					const persistExpanded = () => {
						const expanded: string[] = [];
						document
							.querySelectorAll<HTMLElement>('.notes-topic.is-expanded')
							.forEach((li) => {
								const s = li.dataset.topic;
								if (s) expanded.push(s);
							});
						try {
							localStorage.setItem(
								'notes-nav-expanded',
								JSON.stringify(expanded),
							);
						} catch {}
					};
					notesTopics.forEach((li) => {
						const slug = li.dataset.topic;
						if (slug && stored.includes(slug)) li.classList.add('is-expanded');
						const caret = li.querySelector<HTMLElement>('.notes-caret');
						if (caret && !caret.dataset.bound) {
							caret.dataset.bound = '1';
							caret.addEventListener('click', (e) => {
								e.preventDefault();
								e.stopPropagation();
								li.classList.toggle('is-expanded');
								persistExpanded();
							});
						}
					});
				}
			};
			setupFloatingUI();
			document.addEventListener('astro:after-swap', setupFloatingUI);

			// 目录滚动高亮（IntersectionObserver）：当前阅读章节对应的目录项高亮。
			// 放在全局脚本中以保障从任意页面导航进入文章后都能生效。
			let tocObserver: IntersectionObserver | null = null;
			const initTocSpy = () => {
				if (tocObserver) {
					tocObserver.disconnect();
					tocObserver = null;
				}
				const links = Array.from(
					document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
				);
				if (links.length === 0) return;
				const linkMap = new Map<string, HTMLAnchorElement[]>();
				for (const l of links) {
					const id = l.getAttribute('data-toc-link');
					if (id) {
						if (!linkMap.has(id)) linkMap.set(id, []);
						linkMap.get(id)!.push(l);
					}
				}
				const headings = Array.from(
					document.querySelectorAll<HTMLElement>(
						'article h2[id], article h3[id]',
					),
				).filter((h) => linkMap.has(h.id));
				if (headings.length === 0) return;

				let activeId: string | null = null;
				const setActive = (id: string) => {
					if (id === activeId) return;
					activeId = id;
					linkMap.forEach((list, lid) => {
						for (const l of list) l.classList.toggle('toc-active', lid === id);
					});
				};

				const visible = new Set<string>();
				const obs = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (e.isIntersecting) visible.add(e.target.id);
							else visible.delete(e.target.id);
						}
						if (visible.size === 0) return;
						const topmost = headings
							.filter((h) => visible.has(h.id))
							.sort(
								(a, b) =>
									a.getBoundingClientRect().top - b.getBoundingClientRect().top,
							)[0];
						if (topmost) setActive(topmost.id);
					},
					{ rootMargin: '-80px 0px -70% 0px', threshold: 0 },
				);
				tocObserver = obs;
				headings.forEach((h) => obs.observe(h));
				setActive(headings[0].id);
			};
			initTocSpy();
			document.addEventListener('astro:page-load', initTocSpy);
			document.addEventListener('astro:after-swap', () =>
				setTimeout(initTocSpy, 0),
			);

			// 目录面板：点击外部 / Esc 关闭（全局只注册一次，每次查询当前元素）
			document.addEventListener('click', (e) => {
				const panel = document.getElementById('mobile-toc');
				const toggle = document.getElementById('toc-toggle');
				if (panel && toggle && panel.classList.contains('is-open')) {
					const target = e.target as Node;
					if (!toggle.contains(target) && !panel.contains(target)) {
						panel.classList.remove('is-open');
						panel.setAttribute('aria-hidden', 'true');
						panel.inert = true;
						toggle.setAttribute('aria-expanded', 'false');
					}
				}
				const navPanel = document.getElementById('notes-nav-panel');
				const navToggle = document.getElementById('notes-nav-toggle');
				if (navPanel && navToggle && navPanel.classList.contains('is-open')) {
					const target = e.target as Node;
					if (!navToggle.contains(target) && !navPanel.contains(target)) {
						navPanel.classList.remove('is-open');
						navPanel.setAttribute('aria-hidden', 'true');
						navPanel.inert = true;
						navToggle.setAttribute('aria-expanded', 'false');
					}
				}
			});
			document.addEventListener('keydown', (e) => {
				if (e.key !== 'Escape') return;
				const panel = document.getElementById('mobile-toc');
				const toggle = document.getElementById('toc-toggle');
				if (panel && panel.classList.contains('is-open')) {
					panel.classList.remove('is-open');
					panel.setAttribute('aria-hidden', 'true');
					panel.inert = true;
					toggle?.setAttribute('aria-expanded', 'false');
				}
				const navPanel = document.getElementById('notes-nav-panel');
				const navToggle = document.getElementById('notes-nav-toggle');
				if (navPanel && navPanel.classList.contains('is-open')) {
					navPanel.classList.remove('is-open');
					navPanel.setAttribute('aria-hidden', 'true');
					navPanel.inert = true;
					navToggle?.setAttribute('aria-expanded', 'false');
				}
			});
		</script>


	</body>
</html>
