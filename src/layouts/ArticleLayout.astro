---
import ContentLayout, { type Heading } from '@/components/ContentLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'articles'>;
	headings: Heading[];
}
const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
---

<ContentLayout
	title={title}
	h1Title={title}
	description={description}
	image={heroImage}
	headings={headings}
	pubDate={pubDate}
	updatedDate={updatedDate}
	tags={tags}
	tagBasePath="/articles/tags/"
	backFallback="/articles"
	section="articles"
>
	<slot />
</ContentLayout>
