---
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Toc from '../components/Toc.astro';
import type { CollectionEntry } from 'astro:content';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}
interface Props {
	post: CollectionEntry<'blog'>;
	headings: Heading[];
}
const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
---

<Layout title={title} description={description} image={heroImage}>
	<article class="prose prose-invert max-w-none prose-headings:scroll-mt-20 prose-pre:bg-transparent prose-pre:p-0">
		<header class="not-prose mb-8">
			<h1 class="mt-0 text-4xl font-bold text-white">{title}</h1>
			<div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-white/60">
				<span>发布于 <FormattedDate date={pubDate} /></span>
				{
					updatedDate && (
						<span>· 更新于 <FormattedDate date={updatedDate} /></span>
					)
				}
			</div>
			{
				tags.length > 0 && (
					<div class="mt-3 flex flex-wrap gap-2 text-xs">
						{tags.map((t) => (
							<span class="rounded-full border border-white/15 bg-white/5 px-2.5 py-0.5 text-white/70">
								#{t}
							</span>
						))}
					</div>
				)
			}
		</header>

		<div class="lg:grid lg:grid-cols-[1fr_10rem] lg:gap-8">
			<div class="min-w-0" data-pagefind-body>
				<slot />
			</div>
			<aside class="hidden lg:block">
				<div class="sticky top-20">
					<Toc headings={headings} />
				</div>
			</aside>
		</div>
	</article>
</Layout>
