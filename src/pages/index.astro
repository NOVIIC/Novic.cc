---
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (
	await getCollection('blog', ({ data }) =>
		import.meta.env.PROD ? !data.draft : true,
	)
)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<Layout title={`${SITE_TITLE} · ${SITE_DESCRIPTION}`} description={SITE_DESCRIPTION}>
	<section class="not-prose mb-12">
		<h1 class="text-4xl font-bold text-white">欢迎来到 {SITE_TITLE}</h1>
		<p class="mt-3 text-lg text-white/70">{SITE_DESCRIPTION}</p>
		<div class="mt-6 flex gap-3 text-sm">
			<a
				href="/blog"
				class="rounded-lg border border-white/15 bg-white/5 px-4 py-2 text-white/80 transition-colors hover:bg-white/10 hover:text-white"
				>浏览全部文章</a
			>
			<a
				href="/rss.xml"
				class="rounded-lg border border-white/15 px-4 py-2 text-white/80 transition-colors hover:bg-white/10 hover:text-white"
				>订阅 RSS</a
			>
		</div>
	</section>

	<h2 class="text-xl font-semibold text-white">最新文章</h2>
	<ul class="mt-4 space-y-4">
		{
			posts.map((post) => (
				<li class="not-prose">
					<a
						href={`/blog/${post.id}/`}
						class="block rounded-xl border border-white/10 bg-white/[0.03] p-5 transition-colors hover:border-white/20 hover:bg-white/[0.06]"
					>
						<div class="flex items-center gap-2 text-xs text-white/50">
							<FormattedDate date={post.data.pubDate} />
							{post.data.tags.length > 0 && (
								<span>· {post.data.tags.join(' / ')}</span>
							)}
						</div>
						<h3 class="mt-1 text-lg font-semibold text-white">
							{post.data.title}
						</h3>
						<p class="mt-1 text-sm text-white/60">{post.data.description}</p>
					</a>
				</li>
			))
		}
	</ul>
</Layout>
