---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';
---

<Layout title={`搜索 · ${SITE_TITLE}`} description="站内搜索">
	<div data-pagefind-ignore>
		<h1 class="text-3xl font-bold text-white">搜索</h1>
		<p class="mt-2 text-white/60">在站内全文检索所有文章。</p>

		<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
		<script is:inline type="module">
			try {
				await import('/pagefind/pagefind-component-ui.js');
			} catch (e) {
				const el = document.getElementById('search-fallback');
				if (el)
					el.textContent =
						'搜索索引在开发模式下尚未生成。请运行 pnpm build && pnpm preview 后使用。';
			}
		</script>

		<div class="not-prose mt-6">
			<p id="search-fallback" class="text-sm text-white/40"></p>
			<pagefind-input instance="blog-search" class="block"></pagefind-input>
			<pagefind-summary instance="blog-search" class="mt-3 block"></pagefind-summary>
			<pagefind-results instance="blog-search" class="mt-4 block"></pagefind-results>
		</div>
	</div>
</Layout>
