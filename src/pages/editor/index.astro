---
import '@/styles/global.css';
import 'katex/dist/katex.min.css';
import { css as atkinsonR } from '@/fonts/atkinson-regular.woff2';
import '@/fonts/atkinson-bold.woff2';
import { css as harmony } from '@/fonts/HarmonyOS_Sans_SC.woff2';
import { css as mapleR } from '@/fonts/MapleMonoNormalNL-NF-CN-Regular.woff2';
import '@/fonts/MapleMonoNormalNL-NF-CN-Bold.woff2';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="robots" content="noindex,nofollow" />
		<link rel="manifest" href="/manifest-editor.json" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<title>Editor</title>
		<style
			is:global
			define:vars={{
				'font-atkinson': atkinsonR.family,
				'font-harmony': harmony.family,
				'font-maple-mono': mapleR.family,
			}}
		></style>
		<style is:global>
			/* ===== 编辑器布局：目录栏宽度 / 收起 / 响应式 ===== */
			:root {
				--editor-header-h: 3rem;
			}
			#sidebar-wrap {
				--sbw: 256px;
				width: var(--sbw);
				flex-shrink: 0;
				transition: margin-left 0.28s cubic-bezier(0.22, 1, 0.36, 1);
			}
			#sidebar-wrap.collapsed {
				margin-left: calc(-1 * var(--sbw));
			}
			#sidebar-wrap.resizing {
				transition: none;
			}
			#sidebar-resizer {
				display: none;
			}
			@media (min-width: 768px) {
				#sidebar-resizer {
					display: block;
				}
				#sidebar-wrap.collapsed + #sidebar-resizer {
					display: none;
				}
			}
			@media (max-width: 767px) {
				#sidebar-wrap {
					position: fixed;
					top: var(--editor-header-h);
					bottom: 0;
					left: 0;
					z-index: 30;
					max-width: 85vw;
					transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
				}
				#sidebar-wrap.collapsed {
					margin-left: 0;
					transform: translateX(-100%);
				}
				#sidebar {
					background-color: rgb(8 11 20 / 0.92);
				}
			}

			/* ===== 模式切换滑块 ===== */
			#mode-toggle {
				--mode-idx: 0;
			}
			#mode-indicator {
				position: absolute;
				top: 2px;
				bottom: 2px;
				left: 2px;
				width: 2.75rem;
				border-radius: 0.375rem;
				background: color-mix(in oklab, var(--color-accent) 32%, transparent);
				box-shadow: 0 0 0 1px
					color-mix(in oklab, var(--color-accent) 35%, transparent) inset;
				transform: translateX(calc(var(--mode-idx) * 100%));
				transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
			}

			/* 目录树行过渡（JS 动态创建，需全局样式） */
			.tree-row {
				transition:
					background-color 0.15s ease,
					color 0.15s ease;
			}

			/* ===== 分屏模式：隐藏左边编辑器滚动条（由右侧预览同步控制） ===== */
			body[data-editor-mode='split'] #cm-container .cm-scroller {
				scrollbar-width: none;
				-ms-overflow-style: none;
			}
			body[data-editor-mode='split']
				#cm-container
				.cm-scroller::-webkit-scrollbar {
				display: none;
			}

			@media (prefers-reduced-motion: reduce) {
				#sidebar-wrap,
				#mode-indicator {
					transition: none;
				}
			}
		</style>
	</head>
	<body
		data-pagefind-ignore
		class="flex h-dvh flex-col overflow-hidden font-sans antialiased"
	>
		<!-- 顶栏 -->
		<header
			class="z-20 flex h-12 shrink-0 items-center gap-1.5 border-b border-white/10 bg-black/30 px-2 backdrop-blur-md sm:gap-3 sm:px-3"
		>
			<button
				id="btn-sidebar"
				class="shrink-0 rounded-md p-1.5 text-white/60 transition-colors hover:bg-white/10 hover:text-white"
				title="收起 / 展开目录栏"
				aria-label="收起 / 展开目录栏"
			>
				<svg
					viewBox="0 0 16 16"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					class="h-4 w-4"
					><rect x="1.5" y="2.5" width="13" height="11" rx="2"></rect><path
						d="M6 2.5v11"></path></svg
				>
			</button>
			<span class="shrink-0 text-sm font-bold text-white/80">Editor</span>
			<div
				id="file-info"
				class="hidden min-w-0 flex-1 items-center gap-2 sm:flex"
			>
				<span id="file-path" class="truncate font-mono text-xs text-white/50"
				></span>
				<span
					id="dirty-dot"
					class="hidden h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
					title="有未保存的修改"></span>
			</div>
			<div class="flex-1 sm:hidden"></div>
			<button
				id="btn-save"
				class="hidden shrink-0 rounded-lg border border-white/10 px-2.5 py-1 text-xs text-white/70 transition-colors hover:border-accent hover:text-white disabled:opacity-40"
				disabled>保存 <kbd class="opacity-60 max-sm:hidden">Ctrl+S</kbd></button
			>
			<div
				id="mode-toggle"
				class="relative hidden shrink-0 rounded-lg border border-white/10 p-0.5 text-xs"
			>
				<span id="mode-indicator" aria-hidden="true"></span>
				<button
					data-mode="edit"
					class="mode-btn relative z-10 w-11 py-1 text-center text-white transition-colors"
					title="仅编辑">编辑</button
				><button
					data-mode="split"
					class="mode-btn relative z-10 w-11 py-1 text-center text-white/55 transition-colors hover:text-white/85"
					title="左编辑右预览，滚动进度同步">分屏</button
				><button
					data-mode="preview"
					class="mode-btn relative z-10 w-11 py-1 text-center text-white/55 transition-colors hover:text-white/85"
					title="仅预览">预览</button
				>
			</div>
		</header>

		<div class="flex min-h-0 flex-1 overflow-hidden">
			<!-- 侧栏：目录树（宽度可调、可收起；移动端为抽屉） -->
			<div id="sidebar-wrap">
				<aside
					id="sidebar"
					class="flex h-full w-full flex-col border-r border-white/10 bg-black/20 backdrop-blur-[2px]"
				>
					<div
						class="flex shrink-0 items-center gap-1 border-b border-white/10 p-2"
					>
						<button
							id="btn-open"
							class="rounded-md px-2 py-1 text-xs text-white/70 transition-colors hover:bg-white/10 hover:text-white"
							title="打开本地目录">打开</button
						>
						<button
							id="btn-refresh"
							class="rounded-md px-2 py-1 text-xs text-white/70 transition-colors hover:bg-white/10 hover:text-white disabled:opacity-40"
							title="重新扫描目录"
							disabled>刷新</button
						>
						<div class="flex-1"></div>
						<button
							id="btn-new-file"
							class="rounded-md px-2 py-1 text-xs text-white/70 transition-colors hover:bg-white/10 hover:text-white disabled:opacity-40"
							title="新建文件"
							disabled>+文件</button
						>
						<button
							id="btn-new-folder"
							class="rounded-md px-2 py-1 text-xs text-white/70 transition-colors hover:bg-white/10 hover:text-white disabled:opacity-40"
							title="新建文件夹"
							disabled>+目录</button
						>
					</div>
					<div id="tree" class="min-h-0 flex-1 overflow-auto p-1.5 text-sm">
					</div>
				</aside>
			</div>
			<div
				id="sidebar-resizer"
				class="w-1.5 shrink-0 cursor-col-resize transition-colors hover:bg-accent/40"
				title="拖动调整目录栏宽度 · 双击恢复默认"
			>
			</div>
			<div
				id="sidebar-backdrop"
				class="fixed inset-0 z-20 hidden bg-black/50 backdrop-blur-[2px] md:hidden"
			>
			</div>

			<!-- 主区域 -->
			<main class="relative flex min-w-0 flex-1 flex-col gap-2 p-2 md:flex-row">
				<!-- 欢迎 / 引导 -->
				<div
					id="welcome"
					class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-4 bg-[#060912]/60 p-6 text-center backdrop-blur-sm"
				>
					<p class="text-white/70">
						打开本地 <code
							class="rounded bg-white/10 px-1.5 py-0.5 font-mono text-xs"
							>src/content</code
						> 目录开始写作
					</p>
					<button
						id="btn-open-welcome"
						class="rounded-xl border border-accent/50 bg-accent/20 px-4 py-2 text-sm text-white transition-all hover:scale-105 hover:bg-accent/30 active:scale-95"
						>选择目录</button
					>
					<p id="restore-hint" class="hidden text-xs text-white/40">
						已找到上次打开的目录，授权后将自动恢复
					</p>
				</div>

				<!-- 不支持的设备 -->
				<div
					id="unsupported"
					class="absolute inset-0 z-20 hidden flex-col items-center justify-center gap-3 bg-[#060912]/80 p-6 text-center backdrop-blur-sm"
				>
					<p class="text-lg font-semibold text-white">当前设备不支持</p>
					<p class="max-w-md text-sm text-white/60">
						本编辑器依赖 File System Access API（<code
							class="rounded bg-white/10 px-1 font-mono text-xs"
							>showDirectoryPicker</code
						>）直接读写本地文件。请使用桌面版 Chrome / Edge 访问。
					</p>
				</div>

				<!-- 编辑器 -->
				<div
					id="cm-container"
					class="min-h-0 min-w-0 flex-1 overflow-hidden rounded-2xl border border-white/10 bg-black/15 backdrop-blur-[2px]"
				>
				</div>

				<!-- 预览 -->
				<div
					id="preview-container"
					class="hidden min-h-0 min-w-0 flex-1 overflow-auto rounded-2xl border border-white/10"
				>
				</div>
			</main>
		</div>

		<div
			id="toast"
			class="popup-bg pointer-events-none fixed bottom-5 left-1/2 z-50 -translate-x-1/2 px-4 py-2 text-sm text-white opacity-0 transition-opacity duration-200"
		>
		</div>

		<script>
			import { init } from '@/editor/main';

			if (import.meta.env.PROD && 'serviceWorker' in navigator) {
				navigator.serviceWorker.register('/editor/sw.js').catch(() => {});
			}

			init();
		</script>
	</body>
</html>
