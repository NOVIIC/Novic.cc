---
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';

const posts = (
	await getCollection('blog', ({ data }) =>
		import.meta.env.PROD ? !data.draft : true,
	)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const byYear = posts.reduce((acc, post) => {
	const y = post.data.pubDate.getFullYear();
	(acc[y] ??= []).push(post);
	return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title={`博客 · ${SITE_TITLE}`} description="所有文章列表">
	<h1 class="text-3xl font-bold text-white">博客</h1>
	<p class="mt-2 text-white/60">共 {posts.length} 篇文章</p>

	{
		years.map((y) => (
			<section class="mt-8 not-prose">
				<h2 class="mb-3 text-sm font-semibold text-white/40">{y}</h2>
				<ul class="space-y-2">
					{byYear[Number(y)].map((post) => (
						<li class="flex flex-col sm:flex-row sm:items-baseline sm:gap-4">
							<span class="shrink-0 text-sm text-white/40 sm:w-28">
								<FormattedDate date={post.data.pubDate} />
							</span>
							<a
								href={`/blog/${post.id}/`}
								class="text-white/90 transition-colors hover:text-[var(--color-accent)]"
							>
								{post.data.title}
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</Layout>
