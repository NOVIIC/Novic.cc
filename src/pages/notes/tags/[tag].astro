---
import Layout from '../../../layouts/Layout.astro';
import BackButton from '../../../components/BackButton.astro';
import NotesNav from '../../../components/NotesNav.astro';
import NotesNavMobile from '../../../components/NotesNavMobile.astro';
import { getNotesTree } from '../../../utils/notes';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	const topics = await getNotesTree();
	const tags = new Set<string>();
	for (const t of topics) {
		for (const tag of t.tags) tags.add(tag);
	}
	return [...tags].map((tag) => ({
		params: { tag },
		props: {
			tag,
			topics: topics
				.filter((t) => t.tags.includes(tag))
				.map((t) => ({
					slug: t.slug,
					title: t.title,
					description: t.description,
					count: t.articles.length,
				})),
		},
	}));
}

const { tag, topics } = Astro.props;
---

<Layout
	title={`#${tag} · ${SITE_TITLE}`}
	description={`标签 ${tag} 下的笔记主题`}
>
	<BackButton fallbackHref="/notes/" slot="floating" />
	<NotesNavMobile slot="floating" />
	<div
		class="mx-auto max-w-3xl xl:max-w-none xl:grid xl:grid-cols-[1fr_minmax(0,48rem)_1fr] xl:gap-6"
	>
		<NotesNav />
		<div class="min-w-0 xl:col-start-2">
			<section class="not-prose mb-8">
				<a
					href="/notes/"
					class="text-sm text-white/60 transition-colors hover:text-accent"
				>
					← Notes
				</a>
				<h1 class="mt-2 text-3xl font-bold text-white">#{tag}</h1>
				<p class="mt-2 text-white/70">共 {topics.length} 个主题</p>
			</section>

			<div class="not-prose grid gap-4 sm:grid-cols-2">
				{
					topics.map((t) => (
						<a
							href={`/notes/${t.slug}/intro/`}
							class="content-bg rounded-xl group p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-gray/70 hover:shadow-lg hover:shadow-black/20 active:scale-[0.99]"
						>
							<div class="flex items-center justify-between">
								<h2 class="text-xl font-semibold text-white">{t.title}</h2>
								<span class="text-sm text-white/50">{t.count} 篇</span>
							</div>
							{t.description && (
								<p class="mt-2 text-sm text-white/60">{t.description}</p>
							)}
						</a>
					))
				}
			</div>
		</div>
	</div>
</Layout>
