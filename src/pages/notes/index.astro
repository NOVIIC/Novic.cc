---
import Layout from '../../layouts/Layout.astro';
import NotesNav from '../../components/NotesNav.astro';
import { getNotesTree, getNotesTags } from '../../utils/notes';
import { SITE_TITLE } from '../../consts';

const [topics, tags] = await Promise.all([getNotesTree(), getNotesTags()]);
---

<Layout title={`Notes · ${SITE_TITLE}`} description="学习笔记，按主题分类">
	<div
		class="mx-auto max-w-3xl xl:max-w-none xl:grid xl:grid-cols-[1fr_minmax(0,48rem)_1fr] xl:gap-6"
	>
		<NotesNav class="xl:col-start-1 xl:justify-self-end xl:w-52" />
		<div class="min-w-0 xl:col-start-2">
			<section class="not-prose mb-10">
				<h1 class="text-3xl font-bold text-white">Notes</h1>
				<p class="mt-2 text-white/70">
					学习笔记
				</p>
			</section>

			{
				tags.length > 0 && (
					<section class="not-prose mb-10">
						<h2 class="mb-3 text-sm font-semibold text-white/50">标签</h2>
						<div class="flex flex-wrap gap-2 text-sm">
							{tags.map(({ tag, count }) => (
								<a
									href={`/notes/tags/${tag}/`}
									class="content-bg rounded-full px-3 py-1 text-white/75 transition-all duration-200 hover:scale-105 hover:border-gray hover:text-white active:scale-95"
								>
									#{tag} <span class="text-white/40">{count}</span>
								</a>
							))}
						</div>
					</section>
				)
			}

			<div class="not-prose grid gap-4 sm:grid-cols-2">
				{
					topics.map((t) => (
						<a
							href={`/notes/${t.slug}/intro/`}
							class="content-bg rounded-xl group p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-gray/70 hover:shadow-lg hover:shadow-black/20 active:scale-[0.99]"
						>
							<div class="flex items-center justify-between">
								<h2 class="text-xl font-semibold text-white">{t.title}</h2>
								<span class="text-sm text-white/50">
									{t.articles.length} 篇
								</span>
							</div>
							<p class="mt-2 text-sm text-white/60">{t.description}</p>
							{t.tags.length > 0 && (
								<div class="mt-3 flex flex-wrap gap-1.5 text-xs text-white/45">
									{t.tags.map((tag) => (
										<span>#{tag}</span>
									))}
								</div>
							)}
						</a>
					))
				}
			</div>
		</div>
	</div>
</Layout>
