---
import Layout from '@/layouts/Layout.astro';
import NotesNav from '@/components/NotesNav.astro';
import TopicCard from '@/components/TopicCard.astro';
import TagCloud from '@/components/TagCloud.astro';
import { getNotesTree, getNotesTags } from '@/utils/notes';
import { SITE_TITLE } from '@/consts';

const [topics, tagsRaw] = await Promise.all([getNotesTree(), getNotesTags()]);
const tags = tagsRaw.map(({ tag, count }) => ({
	tag,
	count,
	href: `/notes/tags/${tag}/`,
}));
---

<Layout title={`Notes · ${SITE_TITLE}`} description="学习笔记，按主题分类">
	<div
		class="mx-auto max-w-3xl lg:max-w-none lg:grid lg:grid-cols-[minmax(9rem,1fr)_minmax(32rem,3fr)_minmax(9rem,1fr)] lg:gap-6 xl:grid-cols-[1fr_minmax(0,48rem)_1fr]"
	>
		<NotesNav topics={topics} />
		<div class="min-w-0 lg:col-start-2">
			<section class="not-prose mb-10">
				<h1 class="text-3xl font-bold text-white">Notes</h1>
				<p class="mt-2 text-white/70">学习笔记</p>
			</section>

			<TagCloud tags={tags} />

			<div class="not-prose grid gap-4 sm:grid-cols-2">
				{
					topics.map((t) => (
						<TopicCard
							topic={{
								slug: t.slug,
								title: t.title,
								description: t.description,
								tags: t.tags,
								count: t.articles.length,
							}}
						/>
					))
				}
			</div>
		</div>
	</div>
</Layout>
