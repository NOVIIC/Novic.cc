---
import { getCollection, render } from 'astro:content';
import NoteLayout from '../../../layouts/NoteLayout.astro';
import { getNotesTree } from '../../../utils/notes';

export async function getStaticPaths() {
	const [notes, topics] = await Promise.all([
		getCollection('notes', ({ data }) =>
			import.meta.env.PROD ? !data.draft : true,
		),
		getNotesTree(),
	]);
	const titleByTopic = new Map(topics.map((t) => [t.slug, t.title]));
	return notes.map((note) => {
		const topic = note.id.split('/')[0];
		const slug = note.id.split('/').slice(1).join('/');
		return {
			params: { topic, slug },
			props: {
				note,
				topic,
				topicTitle: titleByTopic.get(topic) ?? topic,
				isIntro: slug === 'intro',
			},
		};
	});
}

const { note, topic, topicTitle, isIntro } = Astro.props;
const { Content, headings } = await render(note);
---

<NoteLayout
	note={note}
	headings={headings}
	topic={topic}
	topicTitle={topicTitle}
	isIntro={isIntro}
>
	<Content />
</NoteLayout>
