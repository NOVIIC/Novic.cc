---
import { getNotesTree } from '../../../utils/notes';

export async function getStaticPaths() {
	const topics = await getNotesTree();
	return topics.map((t) => ({
		params: { topic: t.slug },
		props: { target: `/notes/${t.slug}/intro/` },
	}));
}

return Astro.redirect(Astro.props.target, 301);
---
