---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';
---

<Layout title={`404 · ${SITE_TITLE}`} description="页面不存在">
	<section class="not-prose py-20 text-center">
		<h1 class="text-4xl font-bold text-white sm:text-6xl">404</h1>
		<p class="mt-4 text-white/70">这里什么都没有，也许它曾经存在过。</p>
		<a
			href="/"
			class="mt-8 inline-block rounded-lg border border-white/15 px-4 py-2 text-white/80 transition-all duration-200 hover:scale-105 hover:bg-white/10 hover:text-white active:scale-95"
			>回到首页</a
		>
	</section>
</Layout>
