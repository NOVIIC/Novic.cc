---
import Layout from '@/layouts/Layout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '@/consts';

export async function getStaticPaths() {
	const posts = await getCollection('articles', ({ data }) =>
		import.meta.env.PROD ? !data.draft : true,
	);
	const tags = new Set<string>();
	for (const post of posts) {
		for (const t of post.data.tags) tags.add(t);
	}
	return [...tags].map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: posts
				.filter((p) => p.data.tags.includes(tag))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tag, posts } = Astro.props;
---

<Layout title={`#${tag} · ${SITE_TITLE}`} description={`标签 ${tag} 下的文章`}>
	<div class="mx-auto max-w-3xl">
		<section class="not-prose mb-8">
			<a
				href="/articles/"
				class="mt-2 text-sm text-white/60 transition-colors hover:text-accent"
			>
				← Articles
			</a>
			<h1 class="mt-2 text-3xl font-bold text-white">
				#{tag}
			</h1>
			<p class="mt-2 text-white/70">共 {posts.length} 篇文章</p>
		</section>

		<ul class="space-y-4">
			{
				posts.map((post) => (
					<li class="not-prose">
						<ArticleCard article={post} showTags={false} />
					</li>
				))
			}
		</ul>
	</div>
</Layout>
